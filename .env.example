# Shelly 1: live als Plus Plug S Gen2 (SNPL-00112EU, Firmware 1.7.5) erkannt.
SHELLY_1_HOST=192.168.123.100
# Live geprüft: Plus Plug S Gen2 meldet Erzeugung positiv auf Phase A/L1.
SHELLY_1_PHASE=L1
SHELLY_1_POWER_DIRECTION=positive
SHELLY_1_ENERGY_FIELD=aenergy
SHELLY_1_MIN_POWER_W=3
SHELLY_1_USERNAME=
SHELLY_1_PASSWORD=

# Live unter Erzeugung geprüft: negative Leistung und steigende Rückenergie.
SHELLY_2_HOST=192.168.123.102
SHELLY_2_PHASE=L1
SHELLY_2_POWER_DIRECTION=negative
SHELLY_2_ENERGY_FIELD=ret_aenergy
SHELLY_2_MIN_POWER_W=3
SHELLY_2_USERNAME=
SHELLY_2_PASSWORD=

POLL_INTERVAL_SECONDS=2
STALE_AFTER_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=3
HTTP_READ_TIMEOUT_SECONDS=2
# Leer: 2 * (Connect-Timeout + Read-Timeout), derzeit 10 Sekunden.
HTTP_TOTAL_TIMEOUT_SECONDS=

# Der Container lauscht unprivilegiert auf 1502; Docker veröffentlicht ihn auf 502.
MODBUS_BIND_ADDRESS=192.168.123.51
MODBUS_HOST_PORT=502
MODBUS_PORT=1502
MODBUS_UNIT_ID=2
MODBUS_SERIAL=FSMEMU0000000001
# Standard: Float-Modell 213. Nur für einen kontrollierten A/B-Test auf 203 ändern.
SUNSPEC_METER_MODEL=213

GRID_FREQUENCY_HZ=50
FALLBACK_VOLTAGE_V=230
# Absoluter Pfad auf dem Docker-Host; muss vor dem Deployment UID/GID 10001 gehören.
STATE_HOST_DIR=/opt/froniussmartmeteremulator/state
STATE_FILE=/var/lib/fronius-smart-meter/state.json
STATE_SAVE_INTERVAL_SECONDS=10
LOG_LEVEL=INFO
